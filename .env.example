# 复制成 .env 后填写；.env 不进仓库
SITE_DOMAIN=geo.example.com
# 只用字母数字（compose 会把它拼进 DATABASE_URL）
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
# DATABASE_URL 由 deploy/docker-compose.yml 根据 MYSQL_PASSWORD 拼出；不用 compose 时自己填，例如：
# DATABASE_URL=mysql+pymysql://geo:<密码>@127.0.0.1:3307/geo?charset=utf8mb4
# 上线前必须轮换（旧 Key 在对话里出现过）
ARK_API_KEY=
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
COOKIE_SECURE=true
